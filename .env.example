# =============================================
# Fashion ERP — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# =============================================

# --- BANCO DE DADOS ---
# Railway Postgres: DATABASE_PUBLIC_URL é preenchida automaticamente
# Para dev local com Docker Compose, use:
DATABASE_URL=postgresql://fashion_user:fashion_pass@localhost:5432/fashion_erp
# DATABASE_PUBLIC_URL=  # usado em Railway (tem precedência sobre DATABASE_URL)

# --- SEGURANÇA ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_essa_chave_por_uma_aleatoria_segura_em_producao

# CORS: origens permitidas separadas por vírgula (use * para liberar tudo em dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001

# --- MERCADO PAGO ---
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chave secreta para validar webhooks do Mercado Pago
MP_WEBHOOK_SECRET=sua_chave_secreta_mp

# --- WHATSAPP ---
# Segredo para validar webhooks do WhatsApp
WPP_WEBHOOK_SECRET=sua_chave_secreta_wpp

# --- SERVIDOR ---
PORT=8001
# URL pública do servidor (para o self-ping manter o servidor acordado no Railway)
PUBLIC_URL=https://seu-app.up.railway.app

# --- OPCIONAL ---
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
