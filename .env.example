# =============================================
# Fashion ERP — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# =============================================

# --- BANCO DE DADOS (Docker Compose / VPS) ---
# Senha do Postgres criado pelo docker-compose (usuário e banco já vêm fixos
# como fashion_user/fashion_erp no docker-compose.yml e docker-compose.prod.yml).
POSTGRES_PASSWORD=troque_esta_senha_por_uma_forte
# Usadas só pelo docker-compose.yml (dev local) — no VPS, docker-compose.prod.yml
# já fixa usuário/banco e não expõe a porta do Postgres publicamente.
POSTGRES_USER=fashion_user
POSTGRES_DB=fashion_erp
DB_PORT=5432

# --- DEPLOY NO VPS (docker-compose.prod.yml) ---
# Personal Access Token do GitHub (escopo leitura de conteúdo), necessário
# porque o repositório é privado e o build é feito direto da URL do GitHub.
# Crie em: https://github.com/settings/tokens (fine-grained, só este repo, Contents: Read-only)
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SEGURANÇA ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_essa_chave_por_uma_aleatoria_segura_em_producao

# CORS: origens permitidas separadas por vírgula (inclua o IP/domínio público do VPS)
ALLOWED_ORIGINS=http://SEU_IP_DO_VPS:8001

# --- WHATSAPP ---
# Segredo para validar webhooks do WhatsApp
WPP_WEBHOOK_SECRET=sua_chave_secreta_wpp

# --- SERVIDOR ---
PORT=8001
# URL pública do servidor, usada pelo self-ping (mantém o processo "quente")
PUBLIC_URL=http://SEU_IP_DO_VPS:8001

# --- OPCIONAL ---
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- RAILWAY (legado, só usado se for hospedar no Railway em vez do VPS Docker) ---
# DATABASE_PUBLIC_URL=
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MP_WEBHOOK_SECRET=sua_chave_secreta_mp
